<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="spreadsheet_oca.Dialog" owl="1">
        <div class="o_dialog o_spreadsheet_oca_dialog">
            <div class="modal d-block" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title text-break" t-esc="title" />
                            <button
                                type="button"
                                class="btn-close"
                                aria-label="Close"
                                t-on-click="onClose"
                            />
                        </div>
                        <div class="modal-body">
                            <t t-slot="default" />
                        </div>
                        <div class="modal-footer justify-content-around justify-content-sm-start flex-wrap gap-1">
                            <t t-slot="buttons">
                                <button
                                    class="btn btn-primary"
                                    t-on-click="onClose"
                                >Close</button>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-backdrop show" />
        </div>
    </t>

    <t t-name="spreadsheet_oca.DialogContainer" owl="1">
        <t t-foreach="props.dialogs" t-as="dialog" t-key="dialog.id">
            <t t-component="dialog.Comp" t-props="dialog.props" />
        </t>
    </t>

</templates>
